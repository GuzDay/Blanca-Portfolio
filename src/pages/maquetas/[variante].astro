---
// TEMPORAL: cada variante de la Home en su propia página (/maquetas/mosaico, etc.)
import VistaInicio, { type VarianteInicio } from '../../components/vistas/VistaInicio.astro';

export function getStaticPaths() {
  const variantes: VarianteInicio[] = ['una-tras-otra', 'mosaico', 'pase'];
  return variantes.map((variante) => ({ params: { variante }, props: { variante } }));
}

const { variante } = Astro.props;
const ruta = `/maquetas/${variante}/`;
---

<VistaInicio idioma="es" variante={variante} alternativas={{ es: ruta, en: ruta }} noIndex />
