---
// PRUEBA (fuera del menú y de los buscadores): fotos entrando y saliendo por la
// pantalla con efecto de gota de agua, detrás del contenido de Contacto.
import Base from '../../layouts/Base.astro';
import BloqueContacto from '../../components/BloqueContacto.astro';
import GotasPrueba from '../../components/GotasPrueba.astro';
import { conBase } from '../../lib/rutas';

const ruta = conBase('/pruebas/gotas/');
---

<Base idioma="es" alternativas={{ es: ruta, en: ruta }} titulo="Prueba: gotas" seccion="contacto" noIndex>
  <GotasPrueba />
  <BloqueContacto idioma="es" />
</Base>
