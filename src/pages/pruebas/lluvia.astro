---
// PRUEBA (fuera del menú y de los buscadores): fotos cayendo como lluvia por
// detrás del contenido de Contacto.
import Base from '../../layouts/Base.astro';
import BloqueContacto from '../../components/BloqueContacto.astro';
import LluviaPrueba from '../../components/LluviaPrueba.astro';
import { conBase } from '../../lib/rutas';

const ruta = conBase('/pruebas/lluvia/');
---

<Base idioma="es" alternativas={{ es: ruta, en: ruta }} titulo="Prueba: lluvia" seccion="contacto" noIndex>
  <LluviaPrueba />
  <BloqueContacto idioma="es" />
</Base>
