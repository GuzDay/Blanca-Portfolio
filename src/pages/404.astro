---
import Base from '../layouts/Base.astro';
---

<Base idioma="es" alternativas={{ es: '/', en: '/en/' }} titulo="404" noIndex>
  <div class="error-404">
    <h1>Página no encontrada</h1>
    <p lang="en">Page not found</p>
    <p class="enlaces">
      <a href="/">Volver al inicio</a>
      <a href="/en/" lang="en">Back to home</a>
    </p>
  </div>
</Base>
