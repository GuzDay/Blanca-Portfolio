---
import Base from '../layouts/Base.astro';
import { urlInicio } from '../lib/rutas';
---

<Base idioma="es" alternativas={{ es: urlInicio('es'), en: urlInicio('en') }} titulo="404" noIndex>
  <div class="error-404">
    <h1>Página no encontrada</h1>
    <p lang="en">Page not found</p>
    <p class="enlaces">
      <a href={urlInicio('es')}>Volver al inicio</a>
      <a href={urlInicio('en')} lang="en">Back to home</a>
    </p>
  </div>
</Base>
