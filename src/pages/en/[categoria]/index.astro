---
import VistaCategoria from '../../../components/vistas/VistaCategoria.astro';
import { categorias } from '../../../i18n/categorias';

export function getStaticPaths() {
  return categorias.map((categoria) => ({ params: { categoria: categoria.slug.en }, props: { categoria } }));
}

const { categoria } = Astro.props;
---

<VistaCategoria idioma="en" categoria={categoria} />
