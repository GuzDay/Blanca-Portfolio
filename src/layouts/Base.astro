---
// Marco común de todas las páginas: <head>, cabecera y pie.
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { ajustes } from '../lib/contenido';
import { conBase } from '../lib/rutas';
import { textos } from '../i18n/textos';
import type { Idioma } from '../i18n/categorias';

interface Props {
  idioma: Idioma;
  alternativas: Record<Idioma, string>; // la misma página en cada idioma
  titulo?: string;
  descripcion?: string;
  imagenSocial?: ImageMetadata; // imagen al compartir el enlace
  categoriaActiva?: string;
  seccion?: 'info';
  datosEstructurados?: boolean;
  noIndex?: boolean;
}

const {
  idioma,
  alternativas,
  titulo,
  descripcion = textos[idioma].descripcion,
  imagenSocial,
  categoriaActiva,
  seccion,
  datosEstructurados = false,
  noIndex = false,
} = Astro.props;

// En la versión de prueba (GitHub Pages) se pide a Google que no la indexe
const sinIndexar = noIndex || import.meta.env.PUBLIC_SIN_INDEXAR === 'true';

const t = textos[idioma];
const tituloCompleto = titulo ? `${titulo} — ${ajustes.nombre}` : `${ajustes.nombre} — ${t.profesion}`;
const absoluta = (ruta: string) => new URL(ruta, Astro.site).href;
const imagenCompartir = imagenSocial
  ? await getImage({ src: imagenSocial, width: 1200, height: 630, format: 'jpg' })
  : undefined;
const persona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: ajustes.nombre,
  jobTitle: t.profesionPersona,
  url: absoluta(conBase('/')),
  sameAs: [`https://www.instagram.com/${ajustes.instagram}/`],
};
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={absoluta(alternativas[idioma])} />
    <link rel="alternate" hreflang="es" href={absoluta(alternativas.es)} />
    <link rel="alternate" hreflang="en" href={absoluta(alternativas.en)} />
    <link rel="alternate" hreflang="x-default" href={absoluta(alternativas.es)} />
    {sinIndexar && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={absoluta(alternativas[idioma])} />
    <meta property="og:locale" content={idioma === 'es' ? 'es_ES' : 'en_US'} />
    {imagenCompartir && <meta property="og:image" content={absoluta(imagenCompartir.src)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={conBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={conBase('/sitemap.xml')} />
    {datosEstructurados && <script is:inline type="application/ld+json" set:html={JSON.stringify(persona)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">{t.saltar}</a>
    <Cabecera idioma={idioma} alternativas={alternativas} categoriaActiva={categoriaActiva} seccion={seccion} />
    <main id="contenido">
      <slot />
    </main>
    <Pie idioma={idioma} />
  </body>
</html>
