---
import ContactoOculto from '../ContactoOculto.astro';
// Texto orientativo. Revisadlo (idealmente con una gestoría o abogado) antes de publicar.
import Base from '../../layouts/Base.astro';
import type { Idioma } from '../../i18n/categorias';
import { textos } from '../../i18n/textos';
import { ajustes } from '../../lib/contenido';
import { urlAvisoLegal } from '../../lib/rutas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
---

<Base
  idioma={idioma}
  alternativas={{ es: urlAvisoLegal('es'), en: urlAvisoLegal('en') }}
  titulo={t.avisoLegal}
>
  <div class="texto-legal">
    {
      idioma === 'es' ? (
        <>
          <h1>Aviso legal</h1>
          <h2>Titular de la web</h2>
          <p>En cumplimiento de la Ley 34/2002, de Servicios de la Sociedad de la Información y de Comercio Electrónico (LSSI-CE), estos son los datos del titular de este sitio web:</p>
          <ul>
            <li>Titular: {ajustes.titular}</li>
            <li>NIF: {ajustes.nif}</li>
            <li>Domicilio: {ajustes.domicilio}</li>
            <li>Email: <ContactoOculto tipo="correo" valor={ajustes.email} /></li>
          </ul>
          <h2>Propiedad intelectual</h2>
          <p>Todas las fotografías y vídeos de esta web son obra de {ajustes.nombre} y están protegidos por la legislación de propiedad intelectual. No se permite su reproducción, distribución, comunicación pública ni transformación, total o parcial, sin autorización expresa y por escrito.</p>
          <h2>Responsabilidad</h2>
          <p>El titular no se hace responsable del uso que terceros hagan de la información publicada ni del contenido de las webs externas enlazadas.</p>
          <h2>Legislación aplicable</h2>
          <p>Este aviso legal se rige por la legislación española.</p>
        </>
      ) : (
        <>
          <h1>Legal notice</h1>
          <h2>Website owner</h2>
          <p>In accordance with Spanish Law 34/2002 on Information Society Services and Electronic Commerce (LSSI-CE), the details of the owner of this website are:</p>
          <ul>
            <li>Owner: {ajustes.titular}</li>
            <li>Tax ID (NIF): {ajustes.nif}</li>
            <li>Address: {ajustes.domicilio}</li>
            <li>Email: <ContactoOculto tipo="correo" valor={ajustes.email} /></li>
          </ul>
          <h2>Intellectual property</h2>
          <p>All photographs and videos on this website are the work of {ajustes.nombre} and are protected by intellectual property law. They may not be reproduced, distributed, publicly communicated or modified, in whole or in part, without express written permission.</p>
          <h2>Liability</h2>
          <p>The owner is not responsible for any use third parties make of the information published here, nor for the content of linked external websites.</p>
          <h2>Applicable law</h2>
          <p>This legal notice is governed by Spanish law.</p>
        </>
      )
    }
  </div>
</Base>
