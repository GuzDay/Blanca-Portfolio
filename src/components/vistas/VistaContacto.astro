---
import Base from '../../layouts/Base.astro';
import Foto from '../Foto.astro';
import type { Idioma } from '../../i18n/categorias';
import { textos } from '../../i18n/textos';
import { ajustes, bioDe, retrato } from '../../lib/contenido';
import { urlContacto } from '../../lib/rutas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const Bio = bioDe(idioma);
---

<Base
  idioma={idioma}
  alternativas={{ es: urlContacto('es'), en: urlContacto('en') }}
  titulo={t.contacto}
  imagenSocial={retrato}
  seccion="contacto"
  datosEstructurados
>
  <div class="contacto">
    {
      retrato && (
        <div class="contacto-retrato">
          <Foto imagen={retrato} alt={ajustes.nombre} sizes="(min-width: 760px) 40vw, 100vw" prioridad />
        </div>
      )
    }
    <div class="contacto-texto">
      <h1 class="visualmente-oculto">{t.contacto}</h1>
      {
        Bio && (
          <div class="contacto-bio">
            <Bio />
          </div>
        )
      }
      <div class="contacto-datos">
        <h2>{t.contacto}</h2>
        <ul>
          <li><a href={`mailto:${ajustes.email}`}>{ajustes.email}</a></li>
          <li>
            <a href={`https://www.instagram.com/${ajustes.instagram}/`} target="_blank" rel="noopener">@{ajustes.instagram}</a>
          </li>
          {
            ajustes.telefono && (
              <li>
                <a href={`tel:${ajustes.telefono.replace(/\s+/g, '')}`}>{ajustes.telefono}</a>
              </li>
            )
          }
        </ul>
      </div>
    </div>
  </div>
</Base>
