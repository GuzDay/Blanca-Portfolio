---
import Base from '../../layouts/Base.astro';
import BloqueContacto from '../BloqueContacto.astro';
import Lluvia from '../Lluvia.astro';
import type { Idioma } from '../../i18n/categorias';
import { textos } from '../../i18n/textos';
import { retrato } from '../../lib/contenido';
import { urlContacto } from '../../lib/rutas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
---

<Base
  idioma={idioma}
  alternativas={{ es: urlContacto('es'), en: urlContacto('en') }}
  titulo={t.contacto}
  imagenSocial={retrato}
  seccion="contacto"
  datosEstructurados
>
  <Lluvia />
  <BloqueContacto idioma={idioma} />
</Base>
