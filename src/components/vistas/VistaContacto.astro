---
import ContactoOculto from '../ContactoOculto.astro';
import Base from '../../layouts/Base.astro';
import Foto from '../Foto.astro';
import type { Idioma } from '../../i18n/categorias';
import { textos } from '../../i18n/textos';
import { ajustes, retrato } from '../../lib/contenido';
import { urlContacto } from '../../lib/rutas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
---

<Base
  idioma={idioma}
  alternativas={{ es: urlContacto('es'), en: urlContacto('en') }}
  titulo={t.contacto}
  imagenSocial={retrato}
  seccion="contacto"
  datosEstructurados
>
  <div class="contacto">
    <h1 class="visualmente-oculto">{t.contacto}</h1>
    {
      retrato && (
        <div class="contacto-retrato">
          <Foto imagen={retrato} alt={ajustes.nombre} sizes="(min-width: 700px) 320px, 70vw" prioridad />
        </div>
      )
    }
    <ul class="contacto-datos">
      <li><ContactoOculto tipo="correo" valor={ajustes.email} /></li>
      <li>
        <a href={`https://www.instagram.com/${ajustes.instagram}/`} target="_blank" rel="noopener">@{ajustes.instagram}</a>
      </li>
      {
        ajustes.telefono && (
          <li>
            <ContactoOculto tipo="telefono" valor={ajustes.telefono} />
          </li>
        )
      }
    </ul>
  </div>
</Base>
