---
import Base from '../../layouts/Base.astro';
import Galeria from '../Galeria.astro';
import type { Categoria, Idioma } from '../../i18n/categorias';
import { textos } from '../../i18n/textos';
import { proyectosDe } from '../../lib/contenido';
import { urlCategoria } from '../../lib/rutas';

interface Props {
  idioma: Idioma;
  categoria: Categoria;
}

const { idioma, categoria } = Astro.props;
const t = textos[idioma];
const lista = proyectosDe(categoria);
// De momento la categoría enseña todas sus fotos seguidas, sin separar por proyecto
const elementos = lista.flatMap((proyecto) => proyecto.galeria);
---

<Base
  idioma={idioma}
  alternativas={{ es: urlCategoria(categoria, 'es'), en: urlCategoria(categoria, 'en') }}
  titulo={categoria.nombre[idioma]}
  imagenSocial={lista[0]?.portada}
  categoriaActiva={categoria.carpeta}
>
  <h1 class="visualmente-oculto">{categoria.nombre[idioma]}</h1>
  {
    elementos.length === 0 ? (
      <p class="vacio">{t.proximamente}</p>
    ) : (
      <Galeria elementos={elementos} titulo={categoria.nombre[idioma]} idioma={idioma} />
    )
  }
</Base>
