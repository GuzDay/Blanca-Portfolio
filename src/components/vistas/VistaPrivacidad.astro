---
import ContactoOculto from '../ContactoOculto.astro';
// Texto orientativo. Revisadlo (idealmente con una gestoría o abogado) antes de publicar.
import Base from '../../layouts/Base.astro';
import type { Idioma } from '../../i18n/categorias';
import { textos } from '../../i18n/textos';
import { ajustes } from '../../lib/contenido';
import { urlPrivacidad } from '../../lib/rutas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
---

<Base
  idioma={idioma}
  alternativas={{ es: urlPrivacidad('es'), en: urlPrivacidad('en') }}
  titulo={t.privacidad}
>
  <div class="texto-legal">
    {
      idioma === 'es' ? (
        <>
          <h1>Política de privacidad</h1>
          <h2>Responsable</h2>
          <p>{ajustes.titular} (NIF {ajustes.nif}). Contacto: <ContactoOculto tipo="correo" valor={ajustes.email} />.</p>
          <h2>Qué datos se tratan</h2>
          <p>Esta web no tiene formularios ni registro de usuarios. Si escribes al email de contacto, tus datos (nombre, dirección de correo y lo que incluyas en el mensaje) se usarán únicamente para responderte y, en su caso, gestionar el encargo.</p>
          <h2>Base legal y conservación</h2>
          <p>La base legal es tu consentimiento al escribir y, si se contrata un servicio, la ejecución de ese contrato. Los datos se conservan el tiempo necesario para atender tu consulta y durante los plazos legales aplicables.</p>
          <h2>Destinatarios</h2>
          <p>No se ceden datos a terceros salvo obligación legal. La web está alojada en Cloudflare, que puede tratar datos técnicos de conexión (como la dirección IP) por motivos de seguridad y funcionamiento.</p>
          <h2>Cookies</h2>
          <p>Esta web no utiliza cookies de análisis ni de publicidad, propias o de terceros.</p>
          <h2>Tus derechos</h2>
          <p>Puedes ejercer tus derechos de acceso, rectificación, supresión, oposición, limitación y portabilidad escribiendo a <ContactoOculto tipo="correo" valor={ajustes.email} />. También puedes presentar una reclamación ante la Agencia Española de Protección de Datos (aepd.es).</p>
        </>
      ) : (
        <>
          <h1>Privacy policy</h1>
          <h2>Data controller</h2>
          <p>{ajustes.titular} (Tax ID {ajustes.nif}). Contact: <ContactoOculto tipo="correo" valor={ajustes.email} />.</p>
          <h2>What data is processed</h2>
          <p>This website has no forms or user accounts. If you write to the contact email, your data (name, email address and whatever you include in your message) will only be used to reply to you and, where applicable, to manage the commission.</p>
          <h2>Legal basis and retention</h2>
          <p>The legal basis is your consent when you write and, if a service is hired, the performance of that contract. Data is kept for as long as needed to handle your enquiry and for the applicable legal periods.</p>
          <h2>Recipients</h2>
          <p>No data is shared with third parties unless legally required. The website is hosted on Cloudflare, which may process technical connection data (such as IP addresses) for security and operational purposes.</p>
          <h2>Cookies</h2>
          <p>This website does not use analytics or advertising cookies, whether first- or third-party.</p>
          <h2>Your rights</h2>
          <p>You can exercise your rights of access, rectification, erasure, objection, restriction and portability by writing to <ContactoOculto tipo="correo" valor={ajustes.email} />. You may also lodge a complaint with the Spanish Data Protection Agency (aepd.es).</p>
        </>
      )
    }
  </div>
</Base>
