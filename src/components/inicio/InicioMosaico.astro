---
// Home, variante "Mosaico": columnas con fotos de distintos tamaños.
import Foto from '../Foto.astro';
import type { Idioma } from '../../i18n/categorias';
import type { FotoInicio } from '../../lib/contenido';
import { urlProyecto } from '../../lib/rutas';

interface Props {
  fotos: FotoInicio[];
  idioma: Idioma;
}

const { fotos, idioma } = Astro.props;
---

<div class="inicio-mosaico">
  {
    fotos.map((foto, i) => (
      <figure>
        <a href={urlProyecto(foto.proyecto, idioma)}>
          <Foto
            imagen={foto.imagen}
            alt={foto.proyecto.titulo}
            sizes="(min-width: 1100px) 460px, (min-width: 700px) 33vw, 50vw"
            prioridad={i < 3}
          />
        </a>
        <figcaption class="pie-foto">
          <span>{foto.proyecto.titulo}</span>
        </figcaption>
      </figure>
    ))
  }
</div>
