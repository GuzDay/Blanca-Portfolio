---
// Home, variante "Espiral": las fotos aparecen una tras otra formando una espiral
// y después el conjunto gira despacio. Las fotos no se inclinan: el grupo gira y
// cada foto gira al revés a la vez, así que siempre se ven rectas.
import Foto from '../Foto.astro';
import type { Idioma } from '../../i18n/categorias';
import { ajustes } from '../../lib/contenido';
import type { FotoInicio } from '../../lib/contenido';
import { urlCategoria } from '../../lib/rutas';

interface Props {
  fotos: FotoInicio[];
  idioma: Idioma;
}

const { fotos, idioma } = Astro.props;

// Ángulo áureo: reparte las fotos alrededor del centro sin que se alineen nunca.
const ANGULO = 137.5;
const SEPARACION = 9; // a más valor, espiral más abierta
// Cuánto se espera antes de la primera foto está en global.css (--espera-portada),
// porque depende de si se ve o no la presentación con el nombre.
const CADENCIA = 55; // tiempo entre una foto y la siguiente (ms)

// Cada foto se coloca en su sitio de la espiral...
const colocadas = fotos.map((foto, i) => {
  const grados = (i * ANGULO) % 360;
  const angulo = (grados * Math.PI) / 180;
  const radio = SEPARACION * Math.sqrt(i + 0.6);
  return {
    foto,
    // Para el orden de aparición: 0 = arriba, y de ahí en el sentido del reloj
    vuelta: (grados + 90) % 360,
    x: (Math.cos(angulo) * radio).toFixed(2),
    y: (Math.sin(angulo) * radio).toFixed(2),
    ancho: foto.vertical ? 15 : 21, // las verticales, más estrechas
  };
});

// ...pero aparecen dando la vuelta al círculo, cada una al lado de la anterior
const giro = [...colocadas].sort((a, b) => a.vuelta - b.vuelta);
const piezas = colocadas.map((pieza) => ({
  ...pieza,
  escalon: giro.indexOf(pieza) * CADENCIA, // su turno dentro de la vuelta
}));
---

<script is:inline>
  // La presentación con el nombre se ve al entrar en la web desde fuera y al recargar.
  // Si vienes de otra página de la propia web, se salta y las fotos entran enseguida.
  var deDentro = document.referrer && document.referrer.indexOf(location.origin + '/') === 0;
  var recarga = performance.getEntriesByType('navigation')[0];
  if (!deDentro || (recarga && recarga.type === 'reload')) {
    document.documentElement.classList.add('con-presentacion');
  }
</script>

<div class="inicio-espiral">
  <p class="espiral-nombre" aria-hidden="true">{ajustes.nombre}</p>
  <div class="espiral-giro">
    {
      piezas.map(({ foto, x, y, ancho, escalon }, i) => (
        <figure
          class="espiral-pieza"
          style={`--x:${x}; --y:${y}; --ancho:${ancho}; --escalon:${escalon}ms`}
        >
          <div class="espiral-contragiro">
            <a href={urlCategoria(foto.proyecto.categoria, idioma)}>
              <Foto
                imagen={foto.imagen}
                alt={foto.proyecto.categoria.nombre[idioma]}
                sizes="(max-width: 700px) 70vw, 32vw"
                prioridad={i < 4}
              />
              <figcaption class="visualmente-oculto">{foto.proyecto.categoria.nombre[idioma]}</figcaption>
            </a>
          </div>
        </figure>
      ))
    }
  </div>
  <p class="espiral-rotulo" aria-hidden="true"></p>
</div>

<script>
  // Mide la cabecera para que la espiral ocupe justo el resto de la pantalla,
  // sin dejar franja en blanco ni provocar scroll (en móvil la cabecera es más alta).
  const medirCabecera = () => {
    const cabecera = document.querySelector<HTMLElement>('.cabecera');
    if (cabecera) {
      document.documentElement.style.setProperty('--alto-cabecera', `${cabecera.offsetHeight}px`);
    }
  };
  medirCabecera();
  window.addEventListener('resize', medirCabecera);

  // El rótulo con el nombre de la categoría sigue a la foto señalada.
  // Va suelto, fuera del grupo que gira, porque "mix-blend-mode" solo se mezcla
  // con lo que hay detrás si no está encerrado en algo con transform o animación.
  const espiral = document.querySelector<HTMLElement>('.inicio-espiral');
  const rotulo = espiral?.querySelector<HTMLElement>('.espiral-rotulo');

  if (espiral && rotulo) {
    let señalada: HTMLElement | null = null;
    let cuadro = 0;

    // Para medir el brillo de lo que queda detrás del rótulo.
    const lienzo = document.createElement('canvas');
    lienzo.width = 8;
    lienzo.height = 8;
    const pincel = lienzo.getContext('2d', { willReadFrequently: true });

    const FONDO = 0.9; // brillo del color de fondo de la web (crema)
    const NEGRO = 0.007; // brillo del #111
    const contraste = (a: number, b: number) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);

    // Brillo medio de la foto en el punto (x, y) de la pantalla, ya mezclado con el
    // fondo según lo apagada que esté esa foto.
    const brilloEn = (x: number, y: number) => {
      const debajo = document.elementsFromPoint(x, y);
      const imagen = debajo.find(
        (el): el is HTMLImageElement => el instanceof HTMLImageElement && !!el.closest('.espiral-pieza'),
      );
      if (!imagen || !pincel || !imagen.naturalWidth) return FONDO;
      const caja = imagen.getBoundingClientRect();
      if (!caja.width || !caja.height) return FONDO;
      const sx = ((x - caja.left) / caja.width) * imagen.naturalWidth;
      const sy = ((y - caja.top) / caja.height) * imagen.naturalHeight;
      const lado = Math.max(8, imagen.naturalWidth / 40);
      try {
        pincel.drawImage(imagen, Math.max(0, sx - lado / 2), Math.max(0, sy - lado / 2), lado, lado, 0, 0, 8, 8);
        const { data } = pincel.getImageData(0, 0, 8, 8);
        let suma = 0;
        for (let i = 0; i < data.length; i += 4) {
          suma += (0.2126 * data[i] + 0.7152 * data[i + 1] + 0.0722 * data[i + 2]) / 255;
        }
        const brilloFoto = suma / (data.length / 4);
        // Las fotos no señaladas están a media opacidad sobre el fondo crema
        const pieza = imagen.closest<HTMLElement>('.espiral-pieza');
        const opacidad = pieza ? parseFloat(getComputedStyle(pieza).opacity) || 1 : 1;
        return opacidad * brilloFoto + (1 - opacidad) * FONDO;
      } catch {
        return FONDO;
      }
    };

    // Elige blanco o casi negro: el que mejor se lea en el trozo peor del rótulo.
    let ultimoAjuste = 0;
    const ajustarColor = () => {
      const caja = rotulo.getBoundingClientRect();
      if (!caja.width) return;
      const y = caja.top + caja.height / 2;
      const puntos = [caja.left + 2, caja.left + caja.width / 2, caja.right - 2].map((x) => brilloEn(x, y));
      const peorNegro = Math.min(...puntos.map((b) => contraste(b, NEGRO)));
      const peorBlanco = Math.min(...puntos.map((b) => contraste(b, 1)));
      rotulo.style.color = peorNegro >= peorBlanco ? '#111' : '#fff';
    };

    // La espiral gira, así que hay que recolocar el rótulo en cada fotograma.
    const seguir = () => {
      if (!señalada) return;
      const imagen = señalada.querySelector('img');
      const caja = (imagen ?? señalada).getBoundingClientRect();
      const base = espiral.getBoundingClientRect();
      rotulo.style.left = `${caja.left - base.left}px`;
      rotulo.style.top = `${caja.bottom - base.top + 8}px`;
      // Medir cuesta, así que se hace unas ocho veces por segundo, no en cada fotograma.
      const ahora = performance.now();
      if (ahora - ultimoAjuste > 120) {
        ultimoAjuste = ahora;
        ajustarColor();
      }
      cuadro = requestAnimationFrame(seguir);
    };

    const mostrar = (pieza: HTMLElement) => {
      const nombre = pieza.querySelector('figcaption')?.textContent?.trim();
      if (!nombre) return;
      rotulo.textContent = nombre;
      señalada = pieza;
      rotulo.classList.add('se-ve');
      cancelAnimationFrame(cuadro);
      seguir();
    };

    const esconder = () => {
      señalada = null;
      cancelAnimationFrame(cuadro);
      rotulo.classList.remove('se-ve');
    };

    for (const pieza of espiral.querySelectorAll<HTMLElement>('.espiral-pieza')) {
      pieza.addEventListener('mouseenter', () => mostrar(pieza));
      pieza.addEventListener('mouseleave', esconder);
      pieza.addEventListener('focusin', () => mostrar(pieza));
      pieza.addEventListener('focusout', esconder);
    }
  }
</script>
