---
import Foto from './Foto.astro';
import Video from './Video.astro';
import { textos } from '../i18n/textos';
import type { Idioma } from '../i18n/categorias';
import type { Elemento } from '../lib/contenido';

interface Props {
  elemento: Elemento;
  sizes: string;
  indice: number; // posición de la foto dentro del visor
  titulo: string;
  genero?: string;
  idioma: Idioma;
}

const { elemento, sizes, indice, titulo, genero, idioma } = Astro.props;
const t = textos[idioma];
// "Basyco - Retiro, fotografía de moda — foto 3" dice bastante más que
// "Moda — foto 3", tanto a quien usa lector de pantalla como a Google Imágenes.
const describir = genero ? t.fotoDe(titulo, genero, indice + 1) : `${titulo} — ${t.foto} ${indice + 1}`;
---

{
  elemento.tipo === 'foto' ? (
    <button type="button" class="abrir-visor" data-indice={indice} aria-label={`${t.ampliar} ${indice + 1}`}>
      <Foto
        imagen={elemento.imagen}
        alt={describir}
        sizes={sizes}
        prioridad={indice === 0}
        calidad={elemento.calidad}
      />
    </button>
  ) : (
    <Video video={elemento} etiqueta={`${titulo} — ${t.video}`} textoReproducir={t.reproducir} />
  )
}
