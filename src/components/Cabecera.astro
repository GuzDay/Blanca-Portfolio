---
// Cabecera: nombre, todas las categorías visibles (un clic) e idioma.
import { categorias, type Idioma } from '../i18n/categorias';
import { textos } from '../i18n/textos';
import { ajustes } from '../lib/contenido';
import { urlCategoria, urlContacto, urlInicio } from '../lib/rutas';

interface Props {
  idioma: Idioma;
  alternativas: Record<Idioma, string>;
  categoriaActiva?: string;
  seccion?: 'contacto';
}

const { idioma, alternativas, categoriaActiva, seccion } = Astro.props;
const t = textos[idioma];
---

<header class="cabecera">
  <div class="cabecera-cristal" aria-hidden="true"></div>
  <a class="marca" href={urlInicio(idioma)}>{ajustes.nombre}</a>
  <button
    class="menu-boton"
    type="button"
    aria-expanded="false"
    aria-controls="menu-principal"
    aria-label={t.abrirMenu}
    data-abrir={t.abrirMenu}
    data-cerrar={t.cerrarMenu}
  >
    <span class="menu-icono" aria-hidden="true"></span>
  </button>
  <nav class="menu" id="menu-principal" aria-label={t.menu}>
    <ul>
      {
        categorias.map((categoria, i) => (
          <li style={`--i:${i}; --j:${categorias.length - i}`}>
            <a
              href={urlCategoria(categoria, idioma)}
              aria-current={categoriaActiva === categoria.carpeta ? 'true' : undefined}
            >
              {categoria.nombre[idioma]}
            </a>
          </li>
        ))
      }
      <li style={`--i:${categorias.length}; --j:0`}>
        <a href={urlContacto(idioma)} aria-current={seccion === 'contacto' ? 'true' : undefined}>{t.contacto}</a>
      </li>
    </ul>
  </nav>
  <div class="idiomas" aria-label={t.idiomas}>
    <a href={alternativas.es} lang="es" hreflang="es" aria-current={idioma === 'es' ? 'true' : undefined}>ES</a>
    <a href={alternativas.en} lang="en" hreflang="en" aria-current={idioma === 'en' ? 'true' : undefined}>EN</a>
  </div>
</header>

<script>
  // Guarda la altura de la cabecera en una variable CSS (la usa la portada)
  const cabecera = document.querySelector<HTMLElement>('.cabecera');
  if (cabecera) {
    const actualizar = () =>
      document.documentElement.style.setProperty('--alto-cabecera', `${cabecera.offsetHeight}px`);
    new ResizeObserver(actualizar).observe(cabecera);
  }

  // Menú hamburguesa (solo se ve en móvil)
  const boton = document.querySelector<HTMLButtonElement>('.menu-boton');
  if (cabecera && boton) {
    const panel = cabecera.querySelector<HTMLElement>('.menu');

    const mostrar = (abierto: boolean) => {
      if (abierto) {
        cabecera.classList.remove('menu-cerrando');
        cabecera.classList.add('menu-abierto');
      } else if (cabecera.classList.contains('menu-abierto')) {
        // Se repliega con la misma animación al revés y se oculta al terminar
        cabecera.classList.remove('menu-abierto');
        cabecera.classList.add('menu-cerrando');
        const terminar = () => {
          cabecera.classList.remove('menu-cerrando');
          panel?.removeEventListener('animationend', alTerminar);
        };
        // Ojo: las secciones también avisan al acabar y su aviso pasa por el panel,
        // así que hay que quedarse solo con el del propio panel.
        const alTerminar = (evento: AnimationEvent) => {
          if (evento.target === panel) terminar();
        };
        panel?.addEventListener('animationend', alTerminar);
        window.setTimeout(terminar, 800); // por si la animación no avisa
      }
      boton.setAttribute('aria-expanded', String(abierto));
      boton.setAttribute('aria-label', (abierto ? boton.dataset.cerrar : boton.dataset.abrir) ?? '');
    };

    boton.addEventListener('click', () => mostrar(!cabecera.classList.contains('menu-abierto')));

    // Se cierra al tocar fuera, con Escape, y si la ventana se hace grande
    document.addEventListener('click', (evento) => {
      if (!cabecera.contains(evento.target as Node)) mostrar(false);
    });
    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape') mostrar(false);
    });
    matchMedia('(min-width: 901px)').addEventListener('change', () => mostrar(false));
  }
</script>
