---
import ContactoOculto from './ContactoOculto.astro';
import type { Idioma } from '../i18n/categorias';
import { textos } from '../i18n/textos';
import { ajustes } from '../lib/contenido';
import { urlAvisoLegal, urlPrivacidad } from '../lib/rutas';

interface Props {
  idioma: Idioma;
  soloCopyright?: boolean; // en Contacto el pie se queda solo con el copyright
}

const { idioma, soloCopyright = false } = Astro.props;
const t = textos[idioma];
const año = new Date().getFullYear();
---

<footer class:list={['pie', soloCopyright && 'pie-minimo']}>
  {
    !soloCopyright && (
      <div>
        <ContactoOculto tipo="correo" valor={ajustes.email} />
        <a href={`https://www.instagram.com/${ajustes.instagram}/`} target="_blank" rel="noopener">
          Instagram
        </a>
      </div>
    )
  }
  <div>
    <span>© {año} {ajustes.nombre}</span>
    {!soloCopyright && <a href={urlAvisoLegal(idioma)}>{t.avisoLegal}</a>}
    {!soloCopyright && <a href={urlPrivacidad(idioma)}>{t.privacidad}</a>}
  </div>
</footer>

<script>
  // La página de contacto centra la foto en la pantalla, y para eso necesita
  // saber cuánto ocupan la cabecera y el pie (ver --alto-pie en global.css)
  const pie = document.querySelector<HTMLElement>('.pie');
  if (pie) {
    const actualizar = () => document.documentElement.style.setProperty('--alto-pie', `${pie.offsetHeight}px`);
    new ResizeObserver(actualizar).observe(pie);
  }
</script>
