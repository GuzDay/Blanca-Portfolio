---
// Visor a pantalla completa: flechas, teclado (← → Esc) y deslizar el dedo en móvil.
import { textos } from '../i18n/textos';
import type { Idioma } from '../i18n/categorias';

interface Props {
  idioma: Idioma;
}

const t = textos[Astro.props.idioma];
---

<dialog class="visor" aria-label={t.visor} tabindex="-1">
  <div class="visor-barra">
    <span class="visor-contador" aria-live="polite"></span>
    <button type="button" class="visor-cerrar">{t.cerrar}</button>
  </div>
  <div class="visor-escenario">
    {/* Tres huecos: la foto anterior, la actual y la siguiente. El carro se
        desplaza para que siempre se vea la del medio; al arrastrar, las vecinas
        asoman por los lados como en un carrusel. */}
    <div class="visor-carro">
      <div class="visor-hueco"><img class="visor-vecina" data-lado="antes" alt="" aria-hidden="true" /></div>
      <div class="visor-hueco"><img class="visor-imagen" alt="" /></div>
      <div class="visor-hueco"><img class="visor-vecina" data-lado="despues" alt="" aria-hidden="true" /></div>
    </div>
    <button type="button" class="visor-anterior" aria-label={t.anterior}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
    </button>
    <button type="button" class="visor-siguiente" aria-label={t.siguiente}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
    </button>
  </div>
</dialog>

<script>
  const visor = document.querySelector<HTMLDialogElement>('.visor');
  const botones = [...document.querySelectorAll<HTMLButtonElement>('.abrir-visor')];

  if (visor && botones.length > 0) {
    const imagen = visor.querySelector<HTMLImageElement>('.visor-imagen')!;
    const contador = visor.querySelector<HTMLElement>('.visor-contador')!;
    const escenario = visor.querySelector<HTMLElement>('.visor-escenario')!;
    let actual = 0;

    // Las flechas se pintan claras u oscuras según lo que tengan detrás.
    // Se mide el brillo de esa zona concreta de la foto (o del fondo de la
    // página, si la foto no llega hasta allí).
    const flechas = [
      visor.querySelector<HTMLElement>('.visor-anterior')!,
      visor.querySelector<HTMLElement>('.visor-siguiente')!,
    ];
    const lienzo = document.createElement('canvas');
    const pincel = lienzo.getContext('2d', { willReadFrequently: true });

    const ajustarFlechas = () => {
      // Solo se puede medir con el visor abierto y la foto ya colocada en pantalla
      if (!pincel || !imagen.naturalWidth || !visor.open) return;
      const marco = imagen.getBoundingClientRect();
      if (!marco.width || !marco.height) return;
      // La flecha se centra en la franja de fondo que queda al lado de la foto:
      // así queda a la misma distancia del borde de la pantalla que de la foto.
      // Con fotos verticales esa franja es enorme, así que se pone un tope para
      // que la flecha no se vaya hacia el medio de la pantalla.
      const caja = escenario.getBoundingClientRect();
      const franja = Math.max(0, marco.left - caja.left);
      const ANCHO_DIBUJO = 17; // lo que mide el chevron
      const hueco = Math.max(28, Math.min(96, franja / 2 - ANCHO_DIBUJO / 2));
      escenario.style.setProperty('--flecha-hueco', `${Math.round(hueco)}px`);

      const LADO = 40;
      lienzo.width = LADO;
      lienzo.height = LADO;
      pincel.drawImage(imagen, 0, 0, LADO, LADO);

      for (const flecha of flechas) {
        const dibujo = flecha.querySelector('svg')!.getBoundingClientRect();
        const x = dibujo.left + dibujo.width / 2;
        const y = dibujo.top + dibujo.height / 2;
        let claro = true; // fuera de la foto está el fondo de la web, que es claro

        if (x >= marco.left && x <= marco.right && y >= marco.top && y <= marco.bottom) {
          const px = Math.min(LADO - 4, Math.max(0, Math.round(((x - marco.left) / marco.width) * LADO) - 2));
          const py = Math.min(LADO - 4, Math.max(0, Math.round(((y - marco.top) / marco.height) * LADO) - 2));
          try {
            const datos = pincel.getImageData(px, py, 4, 4).data;
            let suma = 0;
            for (let i = 0; i < datos.length; i += 4) {
              suma += 0.2126 * datos[i] + 0.7152 * datos[i + 1] + 0.0722 * datos[i + 2];
            }
            claro = suma / (datos.length / 4) > 140;
          } catch {
            claro = false; // si no se puede medir, se quedan blancas
          }
        }
        flecha.classList.toggle('sobre-claro', claro);
      }
    };

    const carro = visor.querySelector<HTMLElement>('.visor-carro')!;
    const vecinaAntes = visor.querySelector<HTMLImageElement>('[data-lado="antes"]')!;
    const vecinaDespues = visor.querySelector<HTMLImageElement>('[data-lado="despues"]')!;

    const pintar = (destino: HTMLImageElement, indice: number, conTexto: boolean) => {
      const origen = botones[(indice + botones.length) % botones.length].querySelector('img');
      if (!origen) return;
      destino.sizes = '100vw';
      destino.srcset = origen.srcset;
      destino.src = origen.src;
      // Las vecinas no llevan texto alternativo: las anunciaría por duplicado
      if (conTexto) destino.alt = origen.alt;
    };

    // Cuánto se corre el carro. Mientras el dedo se mueve se escribe una sola
    // vez por fotograma: escribirlo en cada evento obliga al navegador a
    // recalcular estilos decenas de veces por segundo y el arrastre va a tirones.
    let desplazamiento = 0;
    let fotogramaPedido = 0;
    const colocar = (px: number) => {
      desplazamiento = px;
      if (fotogramaPedido) return;
      fotogramaPedido = requestAnimationFrame(() => {
        fotogramaPedido = 0;
        carro.style.setProperty('--arrastre', `${desplazamiento}px`);
      });
    };
    // Para empezar o cortar una animación hace falta escribirlo en el acto
    const colocarYa = (px: number) => {
      desplazamiento = px;
      if (fotogramaPedido) {
        cancelAnimationFrame(fotogramaPedido);
        fotogramaPedido = 0;
      }
      carro.style.setProperty('--arrastre', `${px}px`);
    };

    const mostrar = (indice: number) => {
      actual = (indice + botones.length) % botones.length;
      carro.classList.remove('deslizando');
      colocarYa(0);
      pintar(imagen, actual, true);
      pintar(vecinaAntes, actual - 1, false);
      pintar(vecinaDespues, actual + 1, false);
      imagen.style.transition = 'none';
      imagen.style.transform = ''; // que la nueva foto no herede la ampliación
      contador.textContent = `${actual + 1} / ${botones.length}`;
      requestAnimationFrame(ajustarFlechas);
    };

    // Cambio de foto con la animación del carrusel: la actual se va por un lado
    // y la vecina ocupa su sitio. Al terminar se recolocan las tres.
    // Si llega una orden nueva con la anterior a medias, la anterior se da por
    // terminada en el acto y la nueva arranca desde ahí. Antes se descartaba, y
    // por eso pasar fotos rápido perdía clics y deslizamientos.
    let cerrarDeslizamiento: (() => void) | null = null;

    const deslizar = (direccion: number) => {
      if (botones.length < 2) return;
      cerrarDeslizamiento?.();
      // Medir fuerza además el repintado: sin eso, quitar y volver a poner la
      // clase en el mismo fotograma se fundiría en uno solo y no habría animación.
      const ancho = carro.getBoundingClientRect().width;
      if (!ancho) {
        mostrar(actual + direccion);
        return;
      }
      carro.classList.add('deslizando');
      colocarYa(-direccion * ancho);
      const alTerminar = (evento: TransitionEvent) => {
        if (evento.target === carro) cerrarDeslizamiento?.();
      };
      const reloj = window.setTimeout(() => cerrarDeslizamiento?.(), 450); // por si no avisa
      cerrarDeslizamiento = () => {
        cerrarDeslizamiento = null;
        window.clearTimeout(reloj);
        carro.removeEventListener('transitionend', alTerminar);
        mostrar(actual + direccion);
      };
      carro.addEventListener('transitionend', alTerminar);
    };

    imagen.addEventListener('load', ajustarFlechas);
    window.addEventListener('resize', ajustarFlechas);

    botones.forEach((boton, indice) =>
      boton.addEventListener('click', () => {
        mostrar(indice);
        visor.showModal();
        // Al abrirse, el navegador da el foco al primer botón ("Cerrar") y algunos
        // lo enmarcan con un recuadro. Se lleva el foco al propio visor: sigue
        // dentro del diálogo, para el teclado y los lectores de pantalla, pero sin
        // dibujar nada.
        visor.focus({ preventScroll: true });
      }),
    );

    visor.querySelector('.visor-cerrar')?.addEventListener('click', () => visor.close());
    visor.querySelector('.visor-anterior')?.addEventListener('click', () => deslizar(-1));
    visor.querySelector('.visor-siguiente')?.addEventListener('click', () => deslizar(1));
    if (botones.length < 2) visor.classList.add('una-foto');

    visor.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowLeft') deslizar(-1);
      if (evento.key === 'ArrowRight') deslizar(1);
    });

    // Arrastrar para cambiar de foto: la foto acompaña al dedo y, al soltar,
    // o termina de pasar o vuelve a su sitio.
    let pellizcoInicial = 0; // distinto de cero mientras se pellizca con dos dedos
    let inicioX: number | null = null;
    let arrastre = 0;
    let huboDeslizamiento = false;
    let dedo = -1;
    // Para reconocer un golpe seco: por dónde iba el dedo y cuándo
    let ultimoX = 0;
    let ultimoInstante = 0;
    let velocidad = 0; // píxeles por milisegundo

    function soltarArrastre() {
      if (inicioX === null) return;
      inicioX = null;
      if (dedo >= 0 && escenario.hasPointerCapture(dedo)) escenario.releasePointerCapture(dedo);
      dedo = -1;

      const ancho = carro.getBoundingClientRect().width || 1;
      // Pasa de foto si se ha recorrido una quinta parte de la pantalla...
      const umbral = Math.min(70, ancho * 0.2);
      // ...o si ha sido un golpe seco, aunque sea corto: es lo que espera
      // cualquiera que pase fotos rápido con el pulgar.
      const golpe = Math.abs(velocidad) > 0.35 && Math.abs(arrastre) > 10;
      carro.classList.add('deslizando');
      if (golpe) deslizar(velocidad < 0 ? 1 : -1);
      else if (Math.abs(arrastre) >= umbral) deslizar(arrastre < 0 ? 1 : -1);
      else colocarYa(0);
      arrastre = 0;
      velocidad = 0;
    }

    escenario.addEventListener('pointerdown', (evento) => {
      if (botones.length < 2 || pellizcoInicial) return;
      if ((evento.target as HTMLElement).closest('button')) return; // las flechas no se arrastran
      if (inicioX !== null) {
        soltarArrastre(); // ha entrado un segundo dedo: esto ya no es un arrastre
        return;
      }
      // Si quedaba un cambio de foto a medias, se da por hecho: así este gesto
      // empieza limpio sobre la foto que toca en vez de ignorarse.
      cerrarDeslizamiento?.();
      dedo = evento.pointerId;
      // Capturar el puntero hace que el gesto siga siendo nuestro aunque el dedo
      // se salga de la foto o del borde de la pantalla.
      escenario.setPointerCapture(dedo);
      inicioX = evento.clientX;
      arrastre = 0;
      velocidad = 0;
      ultimoX = evento.clientX;
      ultimoInstante = evento.timeStamp;
      huboDeslizamiento = false;
      carro.classList.remove('deslizando');
    });

    escenario.addEventListener('pointermove', (evento) => {
      if (inicioX === null || evento.pointerId !== dedo) return;
      if (pellizcoInicial) {
        soltarArrastre();
        return;
      }
      arrastre = evento.clientX - inicioX;
      if (Math.abs(arrastre) > 8) huboDeslizamiento = true;
      const transcurrido = evento.timeStamp - ultimoInstante;
      if (transcurrido > 0) {
        // Se mezcla con lo anterior para que un temblor del último instante no mande
        velocidad = velocidad * 0.4 + ((evento.clientX - ultimoX) / transcurrido) * 0.6;
        ultimoX = evento.clientX;
        ultimoInstante = evento.timeStamp;
      }
      colocar(arrastre);
    });

    escenario.addEventListener('pointerup', soltarArrastre);
    escenario.addEventListener('pointercancel', soltarArrastre);

    // Ampliar la foto pellizcando con dos dedos. Al soltar, vuelve a su tamaño sola.
    const AMPLIACION_MAXIMA = 4;

    const separacion = (dedos: TouchList) =>
      Math.hypot(dedos[0].clientX - dedos[1].clientX, dedos[0].clientY - dedos[1].clientY);

    const soltarPellizco = () => {
      if (!pellizcoInicial) return;
      pellizcoInicial = 0;
      imagen.style.transition = 'transform 0.25s ease';
      imagen.style.transform = '';
    };

    escenario.addEventListener(
      'touchstart',
      (evento) => {
        if (evento.touches.length !== 2) return;
        soltarArrastre(); // dos dedos no son un deslizamiento para pasar de foto
        pellizcoInicial = separacion(evento.touches);
        // Se amplía por donde pellizcas, no por el centro de la foto
        const caja = imagen.getBoundingClientRect();
        const x = (evento.touches[0].clientX + evento.touches[1].clientX) / 2;
        const y = (evento.touches[0].clientY + evento.touches[1].clientY) / 2;
        imagen.style.transformOrigin = `${((x - caja.left) / caja.width) * 100}% ${((y - caja.top) / caja.height) * 100}%`;
        imagen.style.transition = 'none';
      },
      { passive: true },
    );

    escenario.addEventListener(
      'touchmove',
      (evento) => {
        if (evento.touches.length !== 2 || !pellizcoInicial) return;
        evento.preventDefault(); // si no, el navegador amplía la página entera
        const escala = Math.min(
          AMPLIACION_MAXIMA,
          Math.max(1, separacion(evento.touches) / pellizcoInicial),
        );
        imagen.style.transform = `scale(${escala})`;
      },
      { passive: false },
    );

    escenario.addEventListener('touchend', soltarPellizco);
    escenario.addEventListener('touchcancel', soltarPellizco);

    // Safari en iPhone tiene además su propio zoom de dos dedos, que ampliaría la
    // página entera por encima del visor. Dentro del visor se desactiva.
    for (const gesto of ['gesturestart', 'gesturechange', 'gestureend']) {
      visor.addEventListener(gesto, (evento) => evento.preventDefault());
    }

    // Tocar fuera de la foto también cierra (la foto, las flechas y los botones no).
    // El carro cubre todo el escenario, así que el margen que rodea a la foto es
    // un ".visor-hueco": sin contarlo, en el móvil no cerraba por ninguna parte.
    visor.addEventListener('click', (evento) => {
      if (huboDeslizamiento) return;
      const donde = evento.target as HTMLElement;
      if (donde === imagen || donde.closest('button')) return;
      if (donde === visor || donde === escenario || donde === carro || donde.closest('.visor-hueco')) {
        visor.close();
      }
    });
  }
</script>
