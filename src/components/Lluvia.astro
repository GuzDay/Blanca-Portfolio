---
// Fotos y vídeos pequeños cayendo de arriba abajo, como lluvia, en la página de
// Contacto. Cada uno cae a su ritmo, con algo de deriva lateral, y se desvanece
// al entrar y al salir. Van por detrás del contenido de la página.
// El material está en contenido/contacto (ver lluviaContacto).
import { getImage } from 'astro:assets';
import Foto from './Foto.astro';
import { lluviaContacto } from '../lib/contenido';

const elementos = await Promise.all(
  lluviaContacto.map(async (elemento) => ({
    ...elemento,
    // Los vídeos no se descargan hasta que les toca caer: solo se ve su portada
    portada:
      elemento.tipo === 'video'
        ? (await getImage({ src: elemento.imagen, width: 640, format: 'webp' })).src
        : undefined,
  })),
);
---

<div class="lluvia" aria-hidden="true">
  {
    elementos.map((elemento) =>
      elemento.tipo === 'video' ? (
        <figure class="lluvia-foto" data-video>
          <video src={elemento.src} poster={elemento.portada} preload="none" muted loop playsinline />
        </figure>
      ) : (
        <figure class="lluvia-foto">
          <Foto imagen={elemento.imagen} alt="" sizes="(max-width: 700px) 22vw, 10vw" />
        </figure>
      ),
    )
  }
</div>

<script>
  const cielo = document.querySelector<HTMLElement>('.lluvia');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cielo && !quieto) {
    const gotas = [...cielo.querySelectorAll<HTMLElement>('.lluvia-foto')];
    const libres = [...gotas];
    const azar = (min: number, max: number) => min + Math.random() * (max - min);
    const movil = () => window.innerWidth <= 700;
    const esVideo = (gota: HTMLElement) => !!gota.querySelector('video');

    // La pantalla se reparte en carriles verticales. En cada carril solo cae una
    // foto a la vez y todas bajan al mismo ritmo, así que nunca se tapan.
    const anchoCarril = () => (movil() ? 31 : 12); // % del ancho de pantalla
    const ocupacion = new Map<number, HTMLElement>();
    const DURACION = 7000; // todas tardan lo mismo: si no, unas alcanzarían a otras

    // Los vídeos pesan, así que solo unos pocos corren a la vez. Y ninguno cae
    // si no va a reproducirse: un vídeo parado se ve como una foto congelada.
    const maxVideos = () => (movil() ? 5 : 6);
    let reproduciendo = 0;

    // El ratón manda en la velocidad: abajo del todo caen muy rápido y, según
    // sube, se van frenando hasta quedarse casi suspendidas.
    const RAPIDO = 3.2;
    const LENTO = 0.07;
    const cayendo = new Set<Animation>();

    // En el móvil no hay cursor que mande la velocidad, así que la lluvia cae
    // más pausada que en el ordenador
    const velocidadNormal = () => (movil() ? 0.28 : 1);
    let velocidad = velocidadNormal();
    let mandaElRaton = false;

    const marcarVelocidad = (y: number) => {
      const altura = Math.max(1, window.innerHeight);
      // Se mide desde abajo: 1 abajo del todo (rápido), 0 arriba (lento)
      const desdeAbajo = Math.min(1, Math.max(0, y / altura));
      // Escala suave (cada tramo acelera en la misma proporción), no a saltos
      velocidad = LENTO * Math.pow(RAPIDO / LENTO, desdeAbajo);
      for (const animacion of cayendo) animacion.playbackRate = velocidad;
    };

    let pendiente = false;
    document.addEventListener('pointermove', (evento) => {
      if (evento.pointerType === 'touch') return;
      mandaElRaton = true;
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        marcarVelocidad(evento.clientY);
      });
    });

    // Coge el siguiente elemento libre por turnos: el que más tiempo lleva sin
    // caer va primero (al terminar, cada uno vuelve al final de la cola). Si ya
    // hay bastantes vídeos en marcha, se salta los vídeos y coge una foto.
    const siguienteLibre = () => {
      const cabeOtroVideo = reproduciendo < maxVideos();
      for (let i = 0; i < libres.length; i++) {
        if (cabeOtroVideo || !esVideo(libres[i])) return libres.splice(i, 1)[0];
      }
      return null;
    };

    // Devuelve false si no hay carril libre: entonces esta foto se queda para la
    // siguiente vuelta en vez de caer encima de otra.
    const lanzar = (gota: HTMLElement, alTerminar: () => void) => {
      const carril = anchoCarril();
      const cuantos = Math.max(3, Math.floor(100 / carril));
      const ancho = Math.min(carril - 1, movil() ? azar(23, 30) : azar(8, 11));
      gota.style.width = `${ancho}vw`;
      gota.style.top = '-12vh'; // empieza justo encima del borde, no muy arriba

      const alto = gota.getBoundingClientRect().height || 200;

      // Un carril está libre si el anterior ya ha bajado lo suficiente
      const libre = (indice: number) => {
        const previo = ocupacion.get(indice);
        if (!previo) return true;
        const caja = previo.getBoundingClientRect();
        return !caja.height || caja.top > alto + 12;
      };

      const orden = Array.from({ length: cuantos }, (_, i) => i).sort(() => Math.random() - 0.5);
      const elegido = orden.find(libre);
      if (elegido === undefined) return false;

      ocupacion.set(elegido, gota);
      const sitio = elegido * (100 / cuantos);
      const sobra = Math.max(0, 100 / cuantos - ancho);
      gota.style.left = `${sitio + azar(0, sobra)}vw`;

      // Cae recta, sin desviarse a los lados
      const caida = gota.animate(
        [
          { transform: 'translate3d(0, 0, 0)', opacity: 0 },
          { opacity: 1, offset: 0.1 },
          { opacity: 1, offset: 0.88 },
          { transform: 'translate3d(0, 145vh, 0)', opacity: 0 },
        ],
        { duration: DURACION, easing: 'linear' },
      );

      caida.playbackRate = velocidad;
      cayendo.add(caida);
      caida.onfinish = () => {
        cayendo.delete(caida);
        if (ocupacion.get(elegido) === gota) ocupacion.delete(elegido);
        alTerminar();
      };
      return true;
    };

    const caer = () => {
      const gota = siguienteLibre();
      if (!gota) return;

      const video = gota.querySelector('video');
      if (!video) {
        if (!lanzar(gota, () => libres.push(gota))) libres.push(gota);
        return;
      }

      // Con un vídeo se espera a que esté rodando de verdad; hasta entonces no
      // cae, para que nunca se vea un vídeo quieto.
      reproduciendo++;
      let resuelto = false;

      const devolver = () => {
        if (resuelto) return;
        resuelto = true;
        video.pause();
        reproduciendo--;
        libres.push(gota);
      };

      const arrancar = () => {
        if (resuelto) return;
        resuelto = true;
        window.clearTimeout(espera);
        const cayo = lanzar(gota, () => {
          video.pause();
          reproduciendo--;
          libres.push(gota);
        });
        if (!cayo) {
          // Sin carril libre: se guarda para la siguiente vuelta
          video.pause();
          reproduciendo--;
          libres.push(gota);
        }
      };

      const espera = window.setTimeout(devolver, 6000); // si tarda mucho, otra vez será
      video.addEventListener('playing', arrancar, { once: true });
      video.currentTime = 0;
      video.play().catch(() => {
        window.clearTimeout(espera);
        devolver();
      });
    };

    // Al cambiar el tamaño de la ventana (o girar el móvil) se recalcula, salvo
    // que el ratón ya esté llevando la velocidad
    window.addEventListener('resize', () => {
      if (mandaElRaton) return;
      velocidad = velocidadNormal();
      for (const animacion of cayendo) animacion.playbackRate = velocidad;
    });

    // El ritmo de aparición acompaña a lo rápida que vaya la lluvia respecto a
    // su ritmo normal (en el móvil ya es más lento), con un tope para que
    // aunque vaya lentísima la pantalla no se quede vacía
    const ciclo = () => {
      caer();
      setTimeout(ciclo, azar(280, 620) / Math.max(velocidad / velocidadNormal(), 0.45));
    };
    setTimeout(ciclo, 300);
  }
</script>
