---
// Fotos y vídeos pequeños cayendo de arriba abajo, como lluvia, en la página de
// Contacto. Cada uno cae a su ritmo, con algo de deriva lateral, y se desvanece
// al entrar y al salir. Van por detrás del contenido de la página.
// El material está en contenido/contacto (ver lluviaContacto).
import { getImage } from 'astro:assets';
import Foto from './Foto.astro';
import { lluviaContacto } from '../lib/contenido';

const elementos = await Promise.all(
  lluviaContacto.map(async (elemento) => ({
    ...elemento,
    // Los vídeos no se descargan hasta que les toca caer: solo se ve su portada
    portada:
      elemento.tipo === 'video'
        ? (await getImage({ src: elemento.imagen, width: 640, format: 'webp' })).src
        : undefined,
  })),
);
---

<div class="lluvia" aria-hidden="true">
  {
    elementos.map((elemento) =>
      elemento.tipo === 'video' ? (
        <figure class="lluvia-foto" data-video>
          <video src={elemento.src} poster={elemento.portada} preload="none" muted loop playsinline />
        </figure>
      ) : (
        <figure class="lluvia-foto">
          <Foto imagen={elemento.imagen} alt="" sizes="(max-width: 700px) 22vw, 10vw" />
        </figure>
      ),
    )
  }
</div>

<script>
  const cielo = document.querySelector<HTMLElement>('.lluvia');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cielo && !quieto) {
    const gotas = [...cielo.querySelectorAll<HTMLElement>('.lluvia-foto')];
    const libres = [...gotas];

    // Los vídeos pesan: solo unos pocos se reproducen a la vez; el resto cae
    // enseñando su portada, que ya está descargada
    const MAX_VIDEOS = 3;
    let reproduciendo = 0;
    const azar = (min: number, max: number) => min + Math.random() * (max - min);
    const movil = () => window.innerWidth <= 700;

    // El ratón manda en la velocidad: abajo del todo caen muy rápido y, según
    // sube, se van frenando hasta quedarse casi suspendidas.
    const RAPIDO = 3.2;
    const LENTO = 0.07;
    const cayendo = new Set<Animation>();

    // En el móvil no hay cursor que mande la velocidad, así que la lluvia cae
    // más pausada que en el ordenador
    const velocidadNormal = () => (movil() ? 0.28 : 1);
    let velocidad = velocidadNormal();
    let mandaElRaton = false;

    const marcarVelocidad = (y: number) => {
      const altura = Math.max(1, window.innerHeight);
      // Se mide desde abajo: 1 abajo del todo (rápido), 0 arriba (lento)
      const desdeAbajo = Math.min(1, Math.max(0, y / altura));
      // Escala suave (cada tramo acelera en la misma proporción), no a saltos
      velocidad = LENTO * Math.pow(RAPIDO / LENTO, desdeAbajo);
      for (const animacion of cayendo) animacion.playbackRate = velocidad;
    };

    let pendiente = false;
    document.addEventListener('pointermove', (evento) => {
      if (evento.pointerType === 'touch') return;
      mandaElRaton = true;
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        marcarVelocidad(evento.clientY);
      });
    });

    const caer = () => {
      const gota = libres.pop();
      if (!gota) return;

      const ancho = movil() ? azar(14, 22) : azar(6, 11); // % del ancho de pantalla
      gota.style.width = `${ancho}vw`;
      gota.style.left = `${azar(-2, 100 - ancho + 2)}vw`;
      gota.style.top = '-12vh'; // empiezan justo encima del borde, no muy arriba

      const deriva = azar(-40, 40); // se desvía un poco al caer, como la lluvia
      const caida = gota.animate(
        [
          { transform: 'translate3d(0, 0, 0)', opacity: 0 },
          { opacity: 1, offset: 0.1 },
          { opacity: 1, offset: 0.88 },
          { transform: `translate3d(${deriva}px, 145vh, 0)`, opacity: 0 },
        ],
        { duration: azar(5200, 9500), easing: 'linear' },
      );

      caida.playbackRate = velocidad;
      cayendo.add(caida);

      const video = gota.querySelector('video');
      let sonando = false;
      if (video && reproduciendo < MAX_VIDEOS) {
        sonando = true;
        reproduciendo++;
        video.currentTime = 0;
        video.play().catch(() => {
          // Si el navegador no deja arrancarlo, se queda la portada
          sonando = false;
          reproduciendo--;
        });
      }

      caida.onfinish = () => {
        cayendo.delete(caida);
        if (video && sonando) {
          video.pause();
          reproduciendo--;
        }
        libres.push(gota);
      };
    };

    // Al cambiar el tamaño de la ventana (o girar el móvil) se recalcula, salvo
    // que el ratón ya esté llevando la velocidad
    window.addEventListener('resize', () => {
      if (mandaElRaton) return;
      velocidad = velocidadNormal();
      for (const animacion of cayendo) animacion.playbackRate = velocidad;
    });

    const ciclo = () => {
      caer();
      // Con la lluvia lenta caen menos fotos, y con la rápida más: así la
      // pantalla no se queda vacía ni se atasca
      // El ritmo acompaña a la velocidad, pero con un tope: aunque la lluvia vaya
      // lentísima, siguen apareciendo fotos y la pantalla no se queda vacía
      // El ritmo acompaña a lo rápida que vaya la lluvia respecto a su ritmo
      // normal (que en el móvil ya es más lento), con un tope para que aunque
      // vaya lentísima sigan apareciendo fotos
      setTimeout(ciclo, azar(280, 620) / Math.max(velocidad / velocidadNormal(), 0.45));
    };
    setTimeout(ciclo, 300);
  }
</script>
