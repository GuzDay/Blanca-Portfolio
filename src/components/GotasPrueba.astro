---
// PRUEBA: fotos que aparecen y desaparecen por la pantalla con efecto de gota de
// agua. La onda se hace con un filtro SVG (feTurbulence + feDisplacementMap) cuya
// fuerza se va a cero, así la foto "se calma" al aparecer. Además se abre en
// círculo desde el centro y se desvanece al irse.
import Foto from './Foto.astro';
import { fotosInicio } from '../lib/contenido';

const RANURAS = 5; // cuántas fotos pueden verse a la vez
const fotos = fotosInicio;
---

<div class="gotas" aria-hidden="true">
  <svg class="gotas-filtros">
    {
      Array.from({ length: RANURAS }, (_, i) => (
        <filter id={`gota-${i}`} x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed={i * 11 + 5} result="ondas" />
          <feDisplacementMap in="SourceGraphic" in2="ondas" scale="0" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      ))
    }
  </svg>
  {
    fotos.map((foto) => (
      <figure class="gota">
        <Foto imagen={foto.imagen} alt="" sizes="(max-width: 700px) 55vw, 24vw" />
      </figure>
    ))
  }
</div>

<script>
  const zona = document.querySelector<HTMLElement>('.gotas');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (zona && !quieto) {
    const fotos = [...zona.querySelectorAll<HTMLElement>('.gota')];
    const filtros = [...zona.querySelectorAll('filter')].map((f) => ({
      id: f.id,
      mapa: f.querySelector('feDisplacementMap')!,
      ondas: f.querySelector('feTurbulence')!,
      libre: true,
    }));

    const azar = (min: number, max: number) => min + Math.random() * (max - min);
    const movil = () => window.innerWidth <= 700;

    // La onda arranca fuerte y se va calmando: eso es lo que parece una gota
    const ondular = (filtro: (typeof filtros)[number], duracion: number) => {
      const arranque = performance.now();
      const paso = (ahora: number) => {
        const avance = Math.min(1, (ahora - arranque) / duracion);
        const suave = 1 - Math.pow(1 - avance, 3);
        filtro.mapa.setAttribute('scale', String((1 - suave) * 55));
        filtro.ondas.setAttribute('baseFrequency', String(0.05 - suave * 0.035));
        if (avance < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };

    const soltar = (foto: HTMLElement) => {
      const filtro = filtros.find((f) => f.libre);
      if (!filtro) return;
      filtro.libre = false;

      const ancho = movil() ? azar(30, 42) : azar(14, 22); // % del ancho de pantalla
      foto.style.width = `${ancho}vw`;
      foto.style.left = '0';
      foto.style.top = '0';
      foto.style.filter = `url(#${filtro.id})`;

      // Se busca un hueco donde no tape la foto ni los datos de contacto
      const alto = (foto.getBoundingClientRect().height / window.innerHeight) * 100;
      const centro = document.querySelector('.contacto')?.getBoundingClientRect();
      const margen = 24; // px de aire alrededor del contacto
      let izquierda = 0;
      let arriba = 0;
      for (let intento = 0; intento < 40; intento++) {
        izquierda = azar(2, Math.max(3, 98 - ancho));
        arriba = azar(3, Math.max(4, 95 - alto));
        if (!centro) break;
        const caja = {
          left: (izquierda / 100) * window.innerWidth,
          top: (arriba / 100) * window.innerHeight,
          right: ((izquierda + ancho) / 100) * window.innerWidth,
          bottom: ((arriba + alto) / 100) * window.innerHeight,
        };
        const choca =
          caja.right > centro.left - margen &&
          caja.left < centro.right + margen &&
          caja.bottom > centro.top - margen &&
          caja.top < centro.bottom + margen;
        if (!choca) break;
      }
      foto.style.left = `${izquierda}vw`;
      foto.style.top = `${arriba}vh`;

      requestAnimationFrame(() => {
        foto.classList.add('se-ve');
        ondular(filtro, 800);
      });

      const quedarse = azar(900, 1500);
      setTimeout(() => {
        foto.classList.remove('se-ve');
        foto.classList.add('se-va');
        setTimeout(() => {
          foto.classList.remove('se-va');
          foto.style.filter = '';
          filtro.libre = true;
        }, 700);
      }, quedarse);
    };

    // Van saliendo en orden aleatorio, sin repetir hasta acabar la vuelta
    let baraja: HTMLElement[] = [];
    const siguiente = () => {
      if (!baraja.length) baraja = [...fotos].sort(() => Math.random() - 0.5);
      return baraja.pop()!;
    };

    const ciclo = () => {
      soltar(siguiente());
      setTimeout(ciclo, azar(420, 780));
    };
    setTimeout(ciclo, 400);
  }
</script>
