---
// Galería con maquetación automática (ver src/lib/galeria.ts).
// Sirve tanto para un proyecto como para una categoría entera.
import ElementoGaleria from './ElementoGaleria.astro';
import Visor from './Visor.astro';
import { agruparEnFilas } from '../lib/galeria';
import type { Idioma } from '../i18n/categorias';
import type { Elemento } from '../lib/contenido';

interface Props {
  elementos: Elemento[];
  titulo: string; // para el texto alternativo de las fotos
  idioma: Idioma;
}

const { elementos, titulo, idioma } = Astro.props;
const filas = agruparEnFilas(elementos);
const fotos = elementos.filter((e) => e.tipo === 'foto');
---

<div class="galeria">
  {
    filas.map((fila) =>
      fila.tipo === 'pareja' ? (
        <div class="fila pareja">
          {fila.elementos.map((elemento) => (
            <ElementoGaleria
              elemento={elemento}
              sizes="(min-width: 1440px) 700px, 50vw"
              indice={fotos.indexOf(elemento)}
              titulo={titulo}
              idioma={idioma}
            />
          ))}
        </div>
      ) : (
        <div class:list={['fila', 'sola', fila.elemento.vertical && 'vertical']}>
          <ElementoGaleria
            elemento={fila.elemento}
            sizes={fila.elemento.vertical ? '(min-width: 800px) 760px, 100vw' : '(min-width: 1440px) 1400px, 100vw'}
            indice={fotos.indexOf(fila.elemento)}
            titulo={titulo}
            idioma={idioma}
          />
        </div>
      ),
    )
  }
</div>

{fotos.length > 0 && <Visor idioma={idioma} />}
