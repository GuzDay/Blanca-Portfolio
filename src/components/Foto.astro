---
// Una foto optimizada: Astro genera varios tamaños y el navegador descarga el adecuado.
import { Image } from 'astro:assets';

interface Props {
  imagen: ImageMetadata;
  alt: string;
  sizes: string; // qué ancho ocupa en pantalla, para elegir el tamaño justo
  prioridad?: boolean; // true solo para la primera foto visible
}

const { imagen, alt, sizes, prioridad = false } = Astro.props;
// Cinco tamaños bien elegidos cubren todos los casos sin generar de más:
//   móvil a pantalla completa (390 px × 3) pide 1170 → coge 1400
//   móvil en pareja (175 × 3) pide 525 → coge 900
//   ordenador retina a pantalla completa (1400 × 2) pide 2800 → coge 2800
//   ordenador retina en pareja (700 × 2) pide 1400 → coge 1400
const ANCHOS = [480, 900, 1400, 2000, 2800];
const anchos = [...new Set([...ANCHOS.filter((w) => w < imagen.width), Math.min(imagen.width, 2800)])];
---

<Image
  src={imagen}
  alt={alt}
  widths={anchos}
  sizes={sizes}
  {/* 86 en vez de 90: pesa una cuarta parte menos y la diferencia no se ve ni
      mirando el pelo o un pata de gallo al 100%. Por debajo de 86 ya se nota. */}
  quality={86}
  loading={prioridad ? 'eager' : 'lazy'}
  fetchpriority={prioridad ? 'high' : 'auto'}
  decoding="async"
/>
